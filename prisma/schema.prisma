generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum TestType {
  TEST
  EXAM
  PRACTICE
}



enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  SUBMITTED
}

model User {
  id           Int            @id @default(autoincrement())
  firstname    String
  lastname     String
  username     String          @unique
  password     String
  role         Role            @default(STUDENT)
  email        String?
  phoneNumber  String?
  classId      Int?
  class        Class?          @relation(fields: [classId], references: [id])
  teacherOf    Class[]         @relation("ClassTeacher")
  courses      Course[]        @relation("CourseTeacher")
  tests        Test[]          @relation("UserTests")
  questionBanks  QuestionBank[]
  testSessions TestSession[]
  notification Notification[]
  createdAt    DateTime        @default(now())
  isDemoUser    Boolean         @default(false) // Indicates if the user is a demo user
}

model Class {
  id          Int             @id @default(autoincrement())
  className   String          @unique
  teacherId   Int?
  teacher     User?           @relation("ClassTeacher", fields: [teacherId], references: [id])
  students    User[]
  courses     Course[]        @relation("ClassCourses")
  notifications Notification[] 
  createdAt   DateTime        @default(now())
}

model Course {
  id          Int             @id @default(autoincrement())
  title       String          @unique
  description String?
  teacherId   Int?
  teacher     User?           @relation("CourseTeacher", fields: [teacherId], references: [id])
  classes     Class[]         @relation("ClassCourses")
  questionBanks  QuestionBank[]
  tests       Test[]
  notifications Notification[] 
  createdAt   DateTime        @default(now())
}

model Test {
  id         Int          @id @default(autoincrement())
  title      String       @unique
  type       TestType
  testState   String      @default("scheduled")
  showResult Boolean      @default(false)  // Controls result visibility for EXAM type
  startTime  DateTime?
  endTime    DateTime?
  duration   Int?
  attemptsAllowed Int?       @default(1)
  passMark   Int
  courseId   Int
  course     Course       @relation(fields: [courseId], references: [id])

  bankId     Int
  bank       QuestionBank @relation(fields: [bankId], references: [id],onDelete: Cascade)

  createdBy  Int
  teacher    User         @relation("UserTests", fields: [createdBy], references: [id])
  sessions   TestSession[]

  createdAt  DateTime     @default(now())
}






model QuestionBank {
  id          Int         @id @default(autoincrement())
  questionBankName        String      @unique
  description String?
  courseId    Int?
  course      Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  tests     Test[]
  questions   Question[]
   images            QuestionBankImage[]
  comprehensions    Comprehension[]
  createdBy   Int?
  teacher     User?        @relation(fields: [createdBy], references: [id],onDelete: SetNull)
  createdAt   DateTime    @default(now())
}

model Question {
  id        Int         @id @default(autoincrement())
  text      String
  options   Json
  answer    String
  marks              Float        @default(1)
  bankId    Int
  bank      QuestionBank @relation(fields: [bankId], references: [id],onDelete: Cascade)
  answers   Answer[]
  imageUrl  String?      // direct image URL for the question
  comprehensionText String?  // direct comprehension content for the question
  createdAt DateTime     @default(now())
}

model QuestionBankImage {
  id             Int          @id @default(autoincrement())
  questionBankId Int
  questionBank   QuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Cascade)
  url            String       // path or URL to the image
  description    String?      // optional caption
  createdAt      DateTime     @default(now())
}

// Multiple comprehension passages for a QuestionBank
model Comprehension {
  id             Int          @id @default(autoincrement())
  questionBankId Int
  questionBank   QuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Cascade)
  title          String
  content        String       // full passage
  createdAt      DateTime     @default(now())
}


model TestSession {
  id         Int           @id @default(autoincrement())
  studentId  Int
  testId     Int
  attemptNo  Int?          @default(1)
  status     SessionStatus @default(IN_PROGRESS)
  startedAt  DateTime      @default(now())
  endedAt    DateTime?
  score      Int?          @default(0)

  student    User          @relation(fields: [studentId], references: [id],onDelete: Cascade)
  test       Test          @relation(fields: [testId], references: [id], onDelete: Cascade)

  answers    Answer[]      
}


model Answer {
  id             Int          @id @default(autoincrement())
  testSessionId  Int
  questionId     Int
  selectedOption String
  isCorrect      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  session        TestSession  @relation(fields: [testSessionId], references: [id],onDelete: Cascade)
  question       Question     @relation(fields: [questionId], references: [id],onDelete: Cascade)
}

model Notification {
  id           Int              @id @default(autoincrement())
  title        String
  message      String
  type         NotificationType // GENERAL, STUDENT, TEACHER, CLASS, COURSE

 
  classId      Int?
  class        Class?           @relation(fields: [classId], references: [id], onDelete: SetNull)

  courseId     Int?
  course       Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)


  createdById  Int?
  createdBy    User?            @relation(fields: [createdById], references: [id])

  createdAt    DateTime         @default(now())
}

enum NotificationType {
  GENERAL   // Everyone
  STUDENT   // All students
  TEACHER   // All teachers
  CLASS     // A specific class
  COURSE    // A specific course
}

model SystemSettings {
  id               Int      @id @default(autoincrement())
  appName          String
  institutionName  String
  shortName        String?     // FCC CBT

  logoUrl          String?     // uploaded logo path
  faviconUrl       String?     // uploaded favicon path
  loginBannerUrl      String?     // uploaded login Banner path

  primaryColor     String?     // hex or rgb e.g.

  supportEmail     String?

  systemStatus     SystemStatus @default(ACTIVE)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum SystemStatus {
  ACTIVE
  MAINTENANCE
}


